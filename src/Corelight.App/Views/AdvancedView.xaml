<UserControl
    x:Class="Corelight.App.Views.AdvancedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Corelight.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:AdvancedViewModel}">

    <UserControl.Resources>
        <!-- Обычный твик: описание слева, переключатель справа. -->
        <DataTemplate DataType="{x:Type vm:TweakItemViewModel}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,6">
                <DockPanel>
                    <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                                     IsChecked="{Binding IsOn}" IsEnabled="{Binding CanToggle}" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource ItemTitle}" Text="{Binding Title}" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource SecondaryText}" Text="{Binding Description}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource WarningText}" Text="{Binding Warning}"
                                   Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource OptionalCaption}" Text="{Binding UnavailableReason}" />
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TweakBadges}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- Приложение: статус и кнопка «Удалить» / «Вернуть». -->
        <DataTemplate DataType="{x:Type vm:AppItemViewModel}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="120">
                        <ui:Button HorizontalAlignment="Stretch" Content="{Binding ActionText}"
                                   Command="{Binding ToggleCommand}" IsEnabled="{Binding CanToggle}" />
                        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Style="{StaticResource CaptionText}" Text="{Binding StatusText}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource ItemTitle}" Text="{Binding Title}" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource SecondaryText}" Text="{Binding Description}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource WarningText}" Text="{Binding Warning}"
                                   Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource OptionalCaption}" Text="{Binding ActionHint}" />
                        <WrapPanel Margin="0,6,0,0">
                            <Border Style="{StaticResource RiskBadge}">
                                <TextBlock FontSize="11" Text="{Binding RiskText}" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- Программа в автозагрузке. -->
        <DataTemplate DataType="{x:Type vm:StartupItemViewModel}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,6">
                <DockPanel>
                    <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" IsChecked="{Binding IsEnabled}" />
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ItemTitle}" Text="{Binding Title}" />
                            <Border Style="{StaticResource Badge}" Margin="8,0,0,0"
                                    Visibility="{Binding IsKnownUpdater, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource BadgeText}" Text="Обычно можно отключить" />
                            </Border>
                        </StackPanel>
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionText}" Text="{Binding Location}" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionText}" Text="{Binding Command}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,16,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" Text="Расширенное" />

        <!-- Вкладки разделов -->
        <ListBox Grid.Row="1" Margin="0,12,0,0"
                 ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"
                 ItemContainerStyle="{StaticResource PillItem}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:AdvancedSectionViewModel}">
                    <StackPanel Orientation="Horizontal" Margin="2,2">
                        <ui:SymbolIcon Symbol="{Binding Info.Icon}" FontSize="16" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Margin="0,12,0,12">
            <TextBlock Style="{StaticResource SecondaryText}" FontSize="14" Text="{Binding SelectedSection.Info.Subtitle}" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}" Text="{Binding SelectedSection.Hint}" />
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding SelectedSection.EmptyText}"
                           Visibility="{Binding SelectedSection.IsEmpty, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                <ItemsControl ItemsSource="{Binding SelectedSection.Items}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
