<UserControl
    x:Class="Corelight.App.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Corelight.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:HomeViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,32,24" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="Оптимизация Windows для игр" />
            <TextBlock Margin="0,6,0,0" Style="{StaticResource SecondaryText}" FontSize="14"
                       Text="Программа найдёт фоновые функции Windows, которые отнимают ресурсы, и предложит их отключить. Перед изменениями создаётся точка восстановления, а каждое изменение можно откатить." />

            <!-- Сканирование -->
            <Border Margin="0,20,0,0" Style="{StaticResource Card}" Padding="20">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" VerticalAlignment="Center"
                               Appearance="Primary" Padding="24,10" FontSize="15"
                               Icon="{ui:SymbolIcon Search24}"
                               Content="Сканировать систему"
                               Command="{Binding ScanCommand}" />
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Проверка системы" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource SecondaryText}"
                                   Text="Сканирование только читает настройки и ничего не меняет. Это займёт несколько секунд." />
                        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   Text="{Binding ScanSummary}"
                                   Visibility="{Binding HasScanSummary, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Сведения о системе -->
            <Border Margin="0,12,0,0" Style="{StaticResource Card}" Padding="20"
                    Visibility="{Binding HasHardware, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Ваша система" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                                <Setter Property="Margin" Value="0,3" />
                            </Style>
                        </Grid.Resources>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Система" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding OsText}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Процессор" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding CpuText}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Видеокарта" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding GpuText}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Память" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding RamText}" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Системный диск" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding DiskText}" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Тип" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding FormFactorText}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Чего ожидать -->
            <Border Margin="0,12,0,0" Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Чего ожидать" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource SecondaryText}"
                               Text="Оптимизация убирает фоновую нагрузку Windows: телеметрию, лишние службы, приложения и задачи. Сильнее всего это сказывается на минимальном FPS (1% low) и плавности кадров: меньше внезапных фризов из-за фоновых задач. Средний FPS на чистой системе обычно растёт в пределах нескольких процентов." />
                    <WrapPanel Margin="0,12,0,0">
                        <WrapPanel.Resources>
                            <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                <Setter Property="Padding" Value="10,4" />
                                <Setter Property="Margin" Value="0,0,8,8" />
                            </Style>
                        </WrapPanel.Resources>
                        <Border><TextBlock Text="✓ Без разгона и изменения частот" /></Border>
                        <Border><TextBlock Text="✓ Не трогает античиты, Secure Boot и Defender" /></Border>
                        <Border><TextBlock Text="✓ Графика системы и игр не меняется" /></Border>
                        <Border><TextBlock Text="✓ Windows Update продолжает работать" /></Border>
                        <Border><TextBlock Text="✓ Любое изменение можно откатить" /></Border>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
