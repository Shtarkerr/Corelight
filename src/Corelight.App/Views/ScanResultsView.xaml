<UserControl
    x:Class="Corelight.App.Views.ScanResultsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Corelight.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:ScanResultsViewModel}">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:ScanItemViewModel}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,6">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,2,8,0"
                              IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Title}" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource ItemTitle}" Text="{Binding Title}" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionText}" Text="{Binding CategoryText}" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource SecondaryText}" Text="{Binding Description}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource WarningText}" Text="{Binding AvailabilityNote}"
                                   Visibility="{Binding HasAvailabilityNote, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource WarningText}" Text="{Binding Warning}"
                                   Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TweakBadges}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,16,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,12" Style="{StaticResource PageTitle}" Text="Результаты сканирования" />

        <!-- Сканирования ещё не было -->
        <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="20"
                Visibility="{Binding HasNoScan, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Content="На главную" Command="{Binding GoHomeCommand}" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource SecondaryText}" VerticalAlignment="Center"
                           Text="Запустите сканирование на главной странице." />
            </DockPanel>
        </Border>

        <!-- Выделяем место справа для полосы, которая накладывается на область прокрутки. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-16,0"
                      Visibility="{Binding HasScan, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="0,0,16,0">
                <Expander Header="{Binding UnknownHeader}" Margin="0,0,0,12"
                          Visibility="{Binding HasUnknownItems, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding UnknownItems}" Margin="12,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Style="{StaticResource ItemTitle}" Text="{Binding Tweak.Title}" />
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding UnavailableReason}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
                <Expander IsExpanded="{Binding IsManualExpanded, Mode=TwoWay}" Margin="0,0,0,16" Padding="16,12"
                          AutomationProperties.Name="{Binding ManualItemsHeader}"
                          Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                          BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
                          Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Wrench24" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Style="{StaticResource ItemTitle}" FontSize="16" VerticalAlignment="Center"
                                       Text="{Binding ManualItemsHeader}" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="16,4,0,8">
                        <TextBlock Style="{StaticResource SecondaryText}" Text="Дополнительных настроек не найдено."
                                   Visibility="{Binding HasNoManualItems, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding ManualItems}" />
                    </StackPanel>
                </Expander>

                <TextBlock Margin="0,0,0,8" Style="{StaticResource SectionTitle}" Text="Рекомендуемые настройки" />
                <TextBlock Style="{StaticResource SecondaryText}" Text="Рекомендаций для этого ПК не найдено."
                           Visibility="{Binding HasNoRecommendedItems, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ScanGroupViewModel}">
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Margin="0,0,0,8" Style="{StaticResource CaptionText}" Text="{Binding Title}" />
                                <ItemsControl ItemsSource="{Binding Items}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Нижняя панель -->
        <Border Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource Card}"
                Visibility="{Binding HasScan, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Appearance="Primary" Padding="20,8"
                           Icon="{ui:SymbolIcon Checkmark24}"
                           Content="Применить выбранное"
                           Command="{Binding ApplyCommand}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource SecondaryText}">
                        <Run Text="Выбрано:" />
                        <Run Text="{Binding SelectedCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Run Text="из" />
                        <Run Text="{Binding TotalCount, Mode=OneWay}" />
                    </TextBlock>
                    <ui:Button Margin="16,0,0,0" Appearance="Transparent" Content="Выбрать рекомендуемые"
                               Command="{Binding SelectRecommendedCommand}" IsEnabled="{Binding HasRecommendedItems}" />
                    <ui:Button Margin="4,0,0,0" Appearance="Transparent" Content="Снять все" Command="{Binding SelectNoneCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
