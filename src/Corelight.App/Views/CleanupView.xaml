<UserControl x:Class="Corelight.App.Views.CleanupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <Style x:Key="CleanupList" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeColumns" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="MinRowHeight" Value="36" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="Transparent" />
        </Style>
        <Style x:Key="CleanupCategoryTile" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="ToolTip" Value="{Binding Description}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Tile" Style="{StaticResource Card}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,16,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,18">
            <ui:Button DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="16,0,0,0"
                       Icon="{ui:SymbolIcon ArrowClockwise24}" Content="Повторить анализ" Command="{Binding AnalyzeCommand}"
                       Visibility="{Binding HasAnalysis, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Style="{StaticResource PageTitle}" Text="Очистка диска" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.44*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Категории очистки" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                <ListBox x:Name="CategoryTiles" Grid.Row="1"
                         ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                         ItemContainerStyle="{StaticResource CleanupCategoryTile}"
                         AutomationProperties.Name="Категории очистки"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" VerticalAlignment="Top" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="17" HorizontalAlignment="Left"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Row="1" Margin="0,5,0,0">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource ItemTitle}" FontSize="13" />
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                                </StackPanel>
                                <CheckBox Grid.Row="2" HorizontalAlignment="Right"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="Включить в очистку"
                                          AutomationProperties.Name="{Binding Title, StringFormat=Включить в очистку: {0}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <DockPanel Grid.Row="2" Margin="0,3,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                        <ui:Button Content="Выбрать все" Command="{Binding SelectAllCommand}" Appearance="Transparent" />
                        <ui:Button Content="Снять все" Command="{Binding SelectNoneCommand}" Appearance="Transparent" />
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                </DockPanel>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="16,13,16,10">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding SelectedCategory.Title}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding SelectedCategory.Description}" Margin="0,4,0,0" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" Style="{StaticResource CleanupList}" ItemsSource="{Binding VisibleItems}" EnableColumnVirtualization="True"
                              Visibility="{Binding ShowsItemSelection, Converter={StaticResource BoolToVisibility}}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Выбор" Width="66" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  AutomationProperties.Name="{Binding Path}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name, Mode=OneWay}" Width="*" IsReadOnly="True" CanUserSort="False">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding Path}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Размер" Binding="{Binding Size}" SortMemberPath="Item.Bytes" Width="85" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right" />
                                        <Setter Property="Margin" Value="0,0,12,0" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid Grid.Row="1" Style="{StaticResource CleanupList}" ItemsSource="{Binding RecycleBinItems}" IsReadOnly="True"
                              Visibility="{Binding IsRecycleBinCategory, Converter={StaticResource BoolToVisibility}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name, Mode=OneWay}" Width="*" CanUserSort="False">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding Name}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Размер" Binding="{Binding Size, Mode=OneWay}" SortMemberPath="Item.Bytes" Width="85">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right" />
                                        <Setter Property="Margin" Value="0,0,12,0" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <ui:Button Grid.Row="2" HorizontalAlignment="Right" Margin="0,14,0,0" Appearance="Primary">
            <ui:Button.Style>
                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                    <Setter Property="Content" Value="Анализировать" />
                    <Setter Property="Command" Value="{Binding AnalyzeCommand}" />
                    <Setter Property="Icon" Value="{ui:SymbolIcon ArrowClockwise24}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasAnalysis}" Value="True">
                            <Setter Property="Content" Value="{Binding CleanButtonText}" />
                            <Setter Property="Command" Value="{Binding CleanCommand}" />
                            <Setter Property="Icon" Value="{ui:SymbolIcon Delete24}" />
                            <Setter Property="IsEnabled" Value="{Binding CanClean}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ui:Button.Style>
        </ui:Button>
    </Grid>
</UserControl>
