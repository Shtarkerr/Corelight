{
  // Сеть. Только системные параметры, никаких изменений DNS, hosts-файла или драйверов сетевой карты.
  "category": "Network",
  "tweaks": [
    {
      "id": "network.delivery-optimization",
      "title": "Отключить раздачу обновлений другим ПК",
      "description": "Отключает раздачу обновлений другим ПК через ваш интернет. Обновления продолжат скачиваться с серверов Microsoft.",
      "recommended": true,
      "impact": "Medium",
      "actions": [
        { "type": "registry", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DeliveryOptimization", "name": "DODownloadMode", "value": "0", "requiredService": "DoSvc" }
      ]
    },
    {
      "id": "network.throttling",
      "title": "Отключить ограничение сети для мультимедиа",
      "description": "Снимает ограничение обработки сетевых пакетов при музыке или видео. Может уменьшить скачки пинга.",
      "recommended": true,
      "actions": [
        { "type": "registry", "path": "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile", "name": "NetworkThrottlingIndex", "value": "0xFFFFFFFF", "requiredService": "MMCSS" }
      ]
    }
  ]
}
