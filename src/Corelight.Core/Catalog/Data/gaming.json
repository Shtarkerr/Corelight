{
  // Игровые настройки. Только штатные параметры Windows: никакого разгона, драйверов,
  // изменения частот или вмешательства в процессы игр.
  "category": "Gaming",
  "tweaks": [
    {
      "id": "gaming.game-mode",
      "title": "Включить игровой режим",
      "description": "Даёт игре приоритет, откладывая фоновые обновления и уведомления Windows.",
      "recommended": true,
      "impact": "Medium",
      "actions": [
        { "type": "registry", "path": "HKCU\\Software\\Microsoft\\GameBar", "name": "AutoGameModeEnabled", "value": "1" },
        { "type": "registry", "path": "HKCU\\Software\\Microsoft\\GameBar", "name": "AllowAutoGameMode", "value": "1" }
      ]
    },
    {
      "id": "gaming.game-dvr",
      "title": "Отключить фоновую запись игр (Game DVR)",
      "description": "Отключает фоновую и ручную запись игр через Xbox Game Bar.",
      "warning": "Запись через Xbox Game Bar (Win+Alt+R) перестанет работать. NVIDIA/AMD/OBS не затрагиваются.",
      "recommended": true,
      "preselected": true,
      "risk": "Caution",
      "impact": "High",
      "actions": [
        { "type": "registry", "path": "HKCU\\System\\GameConfigStore", "name": "GameDVR_Enabled", "value": "0", "default": "1", "requiredPackage": "Microsoft.XboxGamingOverlay" },
        { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\GameDVR", "name": "AppCaptureEnabled", "value": "0", "requiredPackage": "Microsoft.XboxGamingOverlay" },
        { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\GameDVR", "name": "HistoricalCaptureEnabled", "value": "0", "requiredPackage": "Microsoft.XboxGamingOverlay" }
      ]
    },
    {
      "id": "gaming.hags",
      "title": "Включить аппаратное планирование GPU (HAGS)",
      "description": "Разгружает процессор, передавая видеокарте планирование памяти и кадров. Обычно снижает задержку; нужен для генерации кадров DLSS 3. Без разгона.",
      "recommended": true,
      "impact": "Medium",
      "requiresReboot": true,
      "requires": [ "hagsSupported" ],
      "actions": [
        { "type": "registry", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\GraphicsDrivers", "name": "HwSchMode", "value": "2" }
      ]
    },
    {
      "id": "gaming.windowed-optimizations",
      "title": "Включить оптимизацию для игр в окне",
      "description": "Современный вывод кадров для оконных и безрамочных игр DirectX 10/11: ниже задержка, доступен VRR. Auto HDR и графика не меняются.",
      "recommended": true,
      "impact": "Medium",
      "minBuild": 22000,
      "actions": [
        { "type": "registryListEntry", "path": "HKCU\\Software\\Microsoft\\DirectX\\UserGpuPreferences", "name": "DirectXUserGlobalSettings", "key": "SwapEffectUpgradeEnable", "value": "1" }
      ]
    },
    {
      "id": "gaming.mmcss-games",
      "title": "Повысить приоритет игр в планировщике мультимедиа",
      "description": "Повышает приоритет CPU и ввода-вывода для игр с профилем MMCSS «Games». Доля CPU для фоновых задач снижается с 20% до 10%.",
      "recommended": true,
      "actions": [
        { "type": "registry", "path": "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile", "name": "SystemResponsiveness", "value": "10", "default": "20", "requiredService": "MMCSS" },
        { "type": "registry", "path": "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile\\Tasks\\Games", "name": "GPU Priority", "value": "8", "default": "8", "requiredService": "MMCSS" },
        { "type": "registry", "path": "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile\\Tasks\\Games", "name": "Priority", "value": "6", "default": "2", "requiredService": "MMCSS" },
        { "type": "registry", "path": "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile\\Tasks\\Games", "name": "Scheduling Category", "kind": "String", "value": "High", "default": "Medium", "requiredService": "MMCSS" },
        { "type": "registry", "path": "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile\\Tasks\\Games", "name": "SFIO Priority", "kind": "String", "value": "High", "default": "Normal", "requiredService": "MMCSS" }
      ]
    },
    {
      "id": "gaming.power-high",
      "title": "Схема питания «Высокая производительность»",
      "description": "Штатная схема Windows с меньшим энергосбережением и быстрым откликом на нагрузку, без разгона.",
      "warning": "Вырастут расход энергии и нагрев в простое; ноутбук быстрее разрядится.",
      "recommended": true,
      "impact": "Medium",
      "recommendWhen": [ "desktop" ],
      "exclusiveGroup": "powerPlan",
      "actions": [
        { "type": "powerPlan", "scheme": "8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c", "copyGuid": "6f1c2a4e-3b7d-4e0a-9c51-0d2b8f7a1e01" }
      ]
    },
    {
      "id": "gaming.power-ultimate",
      "title": "Схема питания «Максимальная производительность»",
      "description": "Штатная схема для рабочих станций без энергосбережения CPU и устройств. Выигрыш к «Высокой производительности» обычно невелик.",
      "warning": "Заметно выше энергопотребление и нагрев в простое. Не рекомендуется для ноутбуков.",
      "risk": "Advanced",
      "exclusiveGroup": "powerPlan",
      "actions": [
        { "type": "powerPlan", "scheme": "e9a42b02-d5df-448d-aa00-03f14749eb61", "copyGuid": "6f1c2a4e-3b7d-4e0a-9c51-0d2b8f7a1e02" }
      ]
    },
    {
      "id": "gaming.mouse-precision",
      "title": "Отключить «Повышенную точность указателя»",
      "description": "Отключает ускорение: расстояние движения курсора больше не зависит от скорости мыши. Действует в играх и на рабочем столе.",
      "warning": "Изменится ощущение курсора. Выбирайте вручную, если предпочитаете движение без ускорения.",
      "recommended": true,
      "risk": "Caution",
      "requiresReboot": true,
      "actions": [
        { "type": "registry", "path": "HKCU\\Control Panel\\Mouse", "name": "MouseSpeed", "kind": "String", "value": "0", "default": "1" },
        { "type": "registry", "path": "HKCU\\Control Panel\\Mouse", "name": "MouseThreshold1", "kind": "String", "value": "0", "default": "6" },
        { "type": "registry", "path": "HKCU\\Control Panel\\Mouse", "name": "MouseThreshold2", "kind": "String", "value": "0", "default": "10" }
      ]
    }
  ]
}
